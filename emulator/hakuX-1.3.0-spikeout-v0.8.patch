@@ -30,10 +32,37 @@ object GpuDriverHelper {
   val driverStorageDir: String get() = appContext.getExternalFilesDir(null)!!.absolutePath + "/gpu_drivers/"
   val hookLibDir: String get() = appContext.applicationInfo.nativeLibraryDir + "/"
 
+  @Synchronized
   fun init(context: Context) {
     appContext = context.applicationContext
     File(driverInstallDir).mkdirs()
     File(driverStorageDir).mkdirs()
+    installSpikeoutDriverOnce()
+  }
+
+  /** Spikeout KR v0.8: the same R8 driver used on the tested Adreno 740. */
+  private fun installSpikeoutDriverOnce() {
+    val prefs = appContext.getSharedPreferences(AppPrefs.NAME, Context.MODE_PRIVATE)
+    if (prefs.getBoolean("spikeout_r8_v08_installed", false)) return
+    if (!supportsCustomDriverLoading()) return
+    try {
+      val bytes = appContext.assets.open("spikeout/Turnip_v26.0.0_R8.zip").use { it.readBytes() }
+      val digest = MessageDigest.getInstance("SHA-256").digest(bytes)
+        .joinToString("") { "%02x".format(it.toInt() and 255) }
+      check(digest == "e634db0f929e2205e95511c769071817d0390180ec72c8e690bc76375e813715")
+      val stored = File(driverStorageDir, "Turnip_v26.0.0_R8.zip")
+      stored.writeBytes(bytes)
+      if (!useDriver(stored)) return
+      val edit = prefs.edit().putBoolean("spikeout_r8_v08_installed", true)
+      if (!prefs.contains("console_timing")) edit.putBoolean("console_timing", false)
+      if (!prefs.contains("show_hitches")) edit.putBoolean("show_hitches", false)
+      if (!prefs.contains("render_scale")) edit.putInt("render_scale", 1)
+      if (!prefs.contains("console_network")) edit.putString("console_network", "off")
+      edit.apply()
+      Log.i(TAG, "Spikeout KR v0.8: installed bundled Turnip 26.0.0-R8")
+    } catch (e: Exception) {
+      Log.e(TAG, "Could not install bundled Spikeout driver", e)
+    }
   }
 
   fun supportsCustomDriverLoading(): Boolean {
